{
    "name": "andrecorugda/synapse",
    "description": "AI-powered low-code app builder for Laravel + Filament: visual pages, database collections, an n8n-style flow engine, end-user auth, and AI that builds whole apps. Self-hosted.",
    "keywords": [
        "laravel",
        "filament",
        "app-builder",
        "low-code",
        "no-code",
        "page-builder",
        "grapesjs",
        "flow-engine",
        "automation",
        "crud",
        "rest-api",
        "directus",
        "ai",
        "ai-builder",
        "openrouter",
        "internal-tools",
        "cms"
    ],
    "homepage": "https://synapse-app.site",
    "license": "MIT",
    "support": {
        "docs": "https://synapse-app.site/docs/",
        "issues": "https://github.com/andrecorugda/synapse-app-builder/issues",
        "source": "https://github.com/andrecorugda/synapse-app-builder"
    },
    "authors": [
        {
            "name": "Andre Corugda",
            "email": "andre.alarcon.corugda@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/expression-language": "^6.0|^7.0"
    },
    "require-dev": {
        "filament/filament": "^4.0|^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.17",
        "laravel/socialite": "^5.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pragmarx/google2fa": "^8.0"
    },
    "suggest": {
        "filament/filament": "Required to use the bundled Filament admin UI (^4.0 or ^5.0).",
        "andrecorugda/ai-openrouter-gateway": "Optimized AI path — metered, versioned prompt, cost caps. Auto-detected when installed.",
        "laravel/socialite": "Enables SSO sign-in (Google, GitHub) for the built app's end-users. Auto-detected when installed.",
        "socialiteproviders/microsoft": "Adds Microsoft / Azure AD SSO (with tenant restriction) on top of Socialite.",
        "pragmarx/google2fa": "Enables authenticator-app (TOTP) two-factor sign-in. Email OTP works without it."
    },
    "autoload": {
        "psr-4": {
            "Andre\\AiPageBuilder\\": "src/",
            "Andre\\AiPageBuilder\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Andre\\AiPageBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Andre\\AiPageBuilder\\AiPageBuilderServiceProvider"
            ],
            "aliases": {
                "PageBuilder": "Andre\\AiPageBuilder\\Facades\\PageBuilder"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
